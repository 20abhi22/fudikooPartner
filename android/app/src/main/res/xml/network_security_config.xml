<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, trusting system CAs. User-installed CAs are not trusted. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
